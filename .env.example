PORT=5000
NODE_ENV=development

# Example: postgresql://postgres:password@localhost:5432/new_project
DATABASE_URL=postgresql://postgres:password@localhost:5432/new_project

# Replace these with long random strings before using the app.
JWT_ACCESS_SECRET=replace_with_a_long_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_refresh_secret

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Comma-separated origins allowed by CORS. Use * only for local experiments.
CORS_ORIGIN=http://localhost:3000
